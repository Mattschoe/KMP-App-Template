<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (English) strings. This is the source of truth: every values-XX/strings.xml
  must contain exactly these keys, with matching %n$s placeholders.
  StringResourceCompletenessTest enforces that.

  Key convention: snake_case with a semantic prefix.
    a11y_*      accessibility / content descriptions
    action_*    button and menu labels reused across pages
    error_*     user-facing error messages (see domain/Error.kt)
    <page>_*    strings belonging to one page
-->
